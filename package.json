{
  "name": "devbox",
  "version": "2.3.0",
  "private": true,
  "description": "Code on your Mac from your phone: terminal, editor and screen, served by the Mac itself.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "doctor": "node scripts/doctor.js",
    "service": "bash scripts/service.sh",
    "test": "cd test && npm install --no-audit --no-fund && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@novnc/novnc": "1.5.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "compression": "1.7.5",
    "express": "4.21.2",
    "jpeg-js": "0.4.4",
    "marked": "12.0.2",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "qrcode-terminal": "0.12.0",
    "ws": "8.18.0"
  }
}
